# VGA demo constraints: pins (interface spec section 8) and clocks
ldc_set_location -site {35} [get_ports clk_12m]
ldc_set_location -site {44} [get_ports vga_hs]
ldc_set_location -site {45} [get_ports vga_vs]
ldc_set_location -site {46} [get_ports vga_r]
ldc_set_location -site {47} [get_ports vga_g]
ldc_set_location -site {48} [get_ports vga_b]

# 48 MHz HSOSC core clock, 12 MHz oscillator (PLL reference) and 25.125
# MHz PLL pixel clock. The only crossings are the text buffer (EBR,
# separate read and write clocks) and the synchronized resets and scroll
# value, so the clocks are asynchronous.
create_clock -name {clk} -period 20.833 [get_nets clk]
create_clock -name {clk_12m} -period 83.333 [get_ports clk_12m]
create_clock -name {pix_clk} -period 39.801 [get_nets pix_clk]
set_clock_groups -asynchronous -group [get_clocks clk] -group [get_clocks clk_12m] -group [get_clocks pix_clk]
